server.port=8080

# Replace with your MongoDB connection string
spring.data.mongodb.uri=${MONGODB_URI:mongodb+srv://YOUR_DB_USER:YOUR_DB_PASSWORD@cluster0.mongodb.net/yourDatabaseName?appName=Cluster0}

# Replace with your Google OAuth2 credentials
spring.security.oauth2.client.registration.google.client-id=${GOOGLE_CLIENT_ID:mock-client-id}
spring.security.oauth2.client.registration.google.client-secret=${GOOGLE_CLIENT_SECRET:mock-client-secret}
spring.security.oauth2.client.registration.google.scope=profile, email

# Replace with your secure JWT secret (at least 256-bit)
app.jwt.secret=${JWT_SECRET:YOUR_SECURE_JWT_SECRET_HERE}
app.jwt.expiration=86400000

# Replace with your Gemini API Key
gemini.api.key=${GEMINI_API_KEY:YOUR_GEMINI_API_KEY_HERE}

# Multipart settings
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=10MB
